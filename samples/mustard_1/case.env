# Test sample: Project Aria demonstration "mustard_1" of the EgoEngine release (pick up a mustard bottle, place it on
# the table). Parameters used by pipeline/run_sample.sh; the values are the ones used for the report.
CASE=mustard_1
SCHEDULE_VARIANT=bridge          # segment boundaries: Anchors at measured contact events, moved to quiet frames
TIME_SCALE=1.5                   # uniform slow-down of the source clock (kappa in the report)
FLOATING_CONFIG=configs/floating_xhand_aria_mustard_1.json
DETOUR_TEMPLATE=configs/floating_xhand_aria_mustard_1_detour.template.json
TABLE_XY="0.32 1.51 -0.44 1.15"  # table rectangle x0 x1 y0 y1 (m, simulation frame)
# Objects a box may have to hold, name:height:width:depth (m)
OCC_OBJECTS="mustard:0.19:0.10:0.061 wine_bottle:0.30:0.075:0.075 cup:0.09:0.085:0.085"
TALL_POCKET="mustard wine_bottle cup"
TALL_SIZES="0.14x0.14 0.18x0.18 0.22x0.10 0.30x0.16"   # footprints tried for the "go around" boxes
OVER_POCKET="cup"
OVER_HEIGHT=0.12
OVER_SIZES="0.14x0.40 0.14x0.34 0.12x0.30"             # footprints tried for the low "go over" box
